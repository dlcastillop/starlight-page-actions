---
import { Icon } from "@astrojs/starlight/components";
import config from "virtual:config";
import Dropdown from "./Dropdown.astro";
import Button from "./Button.astro";
import { getLocaleConfig } from "../utils/getLocaleConfig.ts";
import ChatGPTIcon from "../icons/Chatgpt.astro";
import ClaudeIcon from "../icons/Claude.astro";
import CursorIcon from "../icons/Cursor.astro";
import EmailIcon from "../icons/Email.astro";
import FacebookIcon from "../icons/Facebook.astro";
import GitHubCopilotIcon from "../icons/GitHubCopilot.astro";
import HackerNewsIcon from "../icons/HackerNews.astro";
import LinkedInIcon from "../icons/LinkedIn.astro";
import MarkdownIcon from "../icons/Markdown.astro";
import PerplexityIcon from "../icons/Perplexity.astro";
import BlueskyIcon from "../icons/Bluesky.astro";
import RedditIcon from "../icons/Reddit.astro";
import T3ChatIcon from "../icons/T3Chat.astro";
import TelegramIcon from "../icons/Telegram.astro";
import ThreadsIcon from "../icons/Threads.astro";
import V0Icon from "../icons/v0.astro";
import WhatsAppIcon from "../icons/WhatsApp.astro";
import XIcon from "../icons/X.astro";
import AIIcon from "../icons/AI.astro";

interface Props {
  variant?: "page-title" | "table-of-contents";
}

const { variant = "page-title" } = Astro.props;

type DefaultActionId =
  | "chatgpt"
  | "claude"
  | "markdown"
  | "v0"
  | "t3chat"
  | "cursor"
  | "perplexity"
  | "githubCopilot";
type IconComponent = (_props: Record<string, unknown>) => unknown;

interface OptionsProps {
  label: string;
  href: string;
  id: string;
  icon?: IconComponent;
}

const currentPath = Astro.url.pathname.replace(/\/$/, "");
const currentUrl = Astro.url.href;
const currentLocale = Astro.currentLocale;
const { actions, share } = config;
const { title, pageActions } = (Astro.locals as any).starlightRoute.entry.data;

const userPrompt = getLocaleConfig(config, currentLocale, "prompt");
const localeActions = getLocaleConfig(config, currentLocale, "actions");
const localeCustomActions = localeActions?.custom;

const promptTemplate = userPrompt ?? Astro.locals.t("prompt.default");
const prompt = promptTemplate.includes("{url}")
  ? promptTemplate.replace("{url}", currentUrl)
  : `${promptTemplate} ${currentUrl}`;
const encodedPrompt = encodeURIComponent(prompt as string);
const encodedCurrentUrl = encodeURIComponent(currentUrl);
const encodedTitle = encodeURIComponent(title as string);

const defaultOptions: Array<OptionsProps & { id: DefaultActionId }> = [
  {
    label: Astro.locals.t("open.chatgpt"),
    href: `https://chatgpt.com/?q=${encodedPrompt}`,
    id: "chatgpt",
    icon: ChatGPTIcon,
  },
  {
    label: Astro.locals.t("open.claude"),
    href: `https://claude.ai/new?q=${encodedPrompt}`,
    id: "claude",
    icon: ClaudeIcon,
  },
  {
    label: Astro.locals.t("open.t3chat"),
    href: `https://t3.chat/new?q=${encodedPrompt}`,
    id: "t3chat",
    icon: T3ChatIcon,
  },
  {
    label: Astro.locals.t("open.v0"),
    href: `https://v0.app/?q=${encodedPrompt}`,
    id: "v0",
    icon: V0Icon,
  },
  {
    label: Astro.locals.t("open.cursor"),
    href: `https://cursor.com/link/prompt?${encodedPrompt}`,
    id: "cursor",
    icon: CursorIcon,
  },
  {
    label: Astro.locals.t("open.perplexity"),
    href: `https://perplexity.ai/?q=${encodedPrompt}`,
    id: "perplexity",
    icon: PerplexityIcon,
  },
  {
    label: Astro.locals.t("open.githubCopilot"),
    href: `https://github.com/copilot/?prompt=${encodedPrompt}`,
    id: "githubCopilot",
    icon: GitHubCopilotIcon,
  },
  {
    label: Astro.locals.t("view.markdown"),
    href: `${currentPath}.md`,
    id: "markdown",
    icon: MarkdownIcon,
  },
];
const filteredDefaultOptions = defaultOptions.filter((option) => {
  const id = option.id;

  if (actions && actions[id]) {
    return option;
  }

  return;
});
const customOptions: OptionsProps[] = actions?.custom
  ? Object.entries(actions.custom).map(([key, value]) => {
      const localeCustomAction = localeCustomActions?.[key];

      return {
        label: localeCustomAction?.label ?? value.label,
        href: `${localeCustomAction?.href ?? value.href}${encodedPrompt}`,
        id: key,
        icon: AIIcon,
      };
    })
  : [];
const actionOptions = [...filteredDefaultOptions, ...customOptions];
const tableOfContentsActionOptions = actionOptions.filter(
  (option) => option.id !== "markdown"
);
const tableOfContentsMarkdownOption = actionOptions.find(
  (option) => option.id === "markdown"
);
const shareOptions = [
  {
    id: "linkedin",
    label: Astro.locals.t("share.linkedin"),
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedCurrentUrl}`,
    icon: LinkedInIcon,
  },
  {
    id: "x",
    label: Astro.locals.t("share.x"),
    href: `https://x.com/intent/tweet?url=${encodedCurrentUrl}&text=${encodedTitle}`,
    icon: XIcon,
  },
  {
    id: "threads",
    label: Astro.locals.t("share.threads"),
    href: `https://threads.net/intent/post?url=${encodedCurrentUrl}&text=${encodedTitle}`,
    icon: ThreadsIcon,
  },
  {
    id: "bluesky",
    label: Astro.locals.t("share.bluesky"),
    href: `https://bsky.app/intent/compose?text=${encodedTitle}%20${encodedCurrentUrl}`,
    icon: BlueskyIcon,
  },
  {
    id: "facebook",
    label: Astro.locals.t("share.facebook"),
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedCurrentUrl}`,
    icon: FacebookIcon,
  },
  {
    id: "reddit",
    label: Astro.locals.t("share.reddit"),
    href: `https://reddit.com/submit?url=${encodedCurrentUrl}&title=${encodedTitle}`,
    icon: RedditIcon,
  },
  {
    id: "hackernews",
    label: Astro.locals.t("share.hackernews"),
    href: `https://news.ycombinator.com/submitlink?u=${encodedCurrentUrl}&t=${encodedTitle}`,
    icon: HackerNewsIcon,
  },
  {
    id: "email",
    label: Astro.locals.t("share.email"),
    href: `mailto:?subject=${encodedTitle}&body=${encodedCurrentUrl}`,
    icon: EmailIcon,
  },
  {
    id: "whatsapp",
    label: Astro.locals.t("share.whatsapp"),
    href: `https://wa.me/?text=${encodedTitle}%20${encodedCurrentUrl}`,
    icon: WhatsAppIcon,
  },
  {
    id: "telegram",
    label: Astro.locals.t("share.telegram"),
    href: `https://t.me/share/url?url=${encodedCurrentUrl}&text=${encodedTitle}`,
    icon: TelegramIcon,
  },
];
---

{
  (pageActions || typeof pageActions === "undefined") &&
  variant === "page-title" ? (
    <div class="actions-container">
      <Button id="copy-markdown" dataPath={currentPath}>
        <MarkdownIcon
          class="icon-default copy-markdown-icon"
          aria-hidden="true"
        />
        <Icon name="approve-check" size="1rem" class="icon-success" />
        <Icon name="error" size="1rem" class="icon-error" />
        <span>{Astro.locals.t("copy.markdown")}</span>
      </Button>

      <div class="dropdown-container">
        {actionOptions.length !== 0 && (
          <Dropdown
            label={Astro.locals.t("open")}
            options={actionOptions}
            id="0"
          />
        )}
        {share && (
          <Dropdown
            label={Astro.locals.t("share")}
            options={shareOptions}
            id="1"
          />
        )}
      </div>
    </div>
  ) : pageActions || typeof pageActions === "undefined" ? (
    <div class="toc-actions">
      <button class="toc-action" id="copy-markdown" data-path={currentPath}>
        <MarkdownIcon
          class="toc-action-icon icon-default copy-markdown-icon"
          aria-hidden="true"
        />
        <Icon name="approve-check" size="1rem" class="icon-success" />
        <Icon name="error" size="1rem" class="icon-error" />
        <span>{Astro.locals.t("copy.markdown")}</span>
      </button>

      {tableOfContentsActionOptions.map((option) => {
        const OptionIcon = option.icon;

        return (
          <a
            href={option.href}
            class="toc-action"
            target="_blank"
            rel="noreferrer"
          >
            {OptionIcon && (
              <OptionIcon
                class="toc-action-icon"
                data-action-icon={option.id}
                aria-hidden="true"
              />
            )}
            <span>{option.label}</span>
            <Icon
              name="external"
              size="1rem"
              class="toc-action-external-icon"
            />
          </a>
        );
      })}

      {tableOfContentsMarkdownOption && (
        <a
          href={tableOfContentsMarkdownOption.href}
          class="toc-action"
          target="_blank"
          rel="noreferrer"
        >
          <MarkdownIcon
            class="toc-action-icon copy-markdown-icon"
            data-action-icon="markdown"
            aria-hidden="true"
          />
          <span>{tableOfContentsMarkdownOption.label}</span>
          <Icon name="external" size="1rem" class="toc-action-external-icon" />
        </a>
      )}
    </div>
  ) : null
}

<style>
  .actions-container,
  .dropdown-container {
    display: flex;
    gap: 0.5rem;
  }

  .actions-container {
    flex-direction: column;
  }

  .toc-actions {
    border-top: 1px solid var(--sl-color-gray-5);
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
  }

  .toc-action {
    --toc-action-bg: var(--sl-color-bg-sidebar);
    align-items: center;
    background: transparent;
    border: 0;
    border-radius: 0.25rem;
    color: var(--sl-color-white);
    cursor: pointer;
    display: flex;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    gap: 0.75rem;
    line-height: 1.4;
    padding: 0.375rem 0.125rem;
    text-align: left;
    text-decoration: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
    width: 100%;
  }

  .toc-action:hover,
  .toc-action:focus-visible {
    color: var(--sl-color-white);
  }

  .toc-action:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .toc-action span {
    flex: 1;
  }

  .toc-action :global(.toc-action-icon),
  .toc-action-external-icon {
    color: currentColor;
    flex: 0 0 1rem;
    height: 1rem;
    width: 1rem;
    transform-origin: center;
  }

  .toc-action :global(.toc-action-icon [fill]:not([fill="none"])) {
    fill: currentColor;
  }

  .toc-action :global(.toc-action-icon [stroke]:not([stroke="none"])) {
    stroke: currentColor;
  }

  .toc-action :global(.toc-action-icon path:not([fill])),
  .toc-action :global(.toc-action-icon circle:not([fill])),
  .toc-action :global(.toc-action-icon ellipse:not([fill])),
  .toc-action :global(.toc-action-icon polygon:not([fill])),
  .toc-action :global(.toc-action-icon rect:not([fill])) {
    fill: currentColor;
  }

  .toc-action :global(.toc-action-icon [data-preserve-fill]) {
    fill: var(--toc-action-bg);
  }

  .toc-action :global(.toc-action-icon[data-action-icon="t3chat"]) {
    transform: scale(1.35);
  }

  .toc-action :global(.toc-action-icon[data-action-icon="githubCopilot"]) {
    transform: scale(1.12);
  }

  .toc-action :global(.toc-action-icon[data-action-icon="cursor"]) {
    transform: scale(0.92);
  }

  #copy-markdown:disabled {
    opacity: 0.7;
  }

  :global(.copy-markdown-icon) {
    color: currentColor;
    width: 1rem;
    height: 1rem;
    transform: scale(1.2);
  }

  :global(.copy-markdown-icon [fill]:not([fill="none"])) {
    fill: currentColor;
  }

  :global(.copy-markdown-icon [stroke]:not([stroke="none"])) {
    stroke: currentColor;
    stroke-width: 10;
  }

  :global(.icon-success),
  :global(.icon-error) {
    display: none;
  }

  :global(#copy-markdown.copied .icon-default),
  :global(#copy-markdown.error .icon-default) {
    display: none;
  }

  :global(#copy-markdown.copied .icon-success) {
    display: block;
  }

  :global(#copy-markdown.error .icon-error) {
    display: block;
  }

  @media (min-width: 425px) {
    .actions-container {
      flex-direction: row;
    }
  }
</style>

<script>
  const copyButton = document.querySelector(
    "#copy-markdown"
  ) as HTMLButtonElement;

  copyButton?.addEventListener("click", async () => {
    let copyButtonClass: "copied" | "error" = "copied";

    try {
      copyButton.disabled = true;

      const currentPath = copyButton.dataset.path;
      const mdPath = `${currentPath}.md`;

      const res = await fetch(mdPath);
      const contentForClipboard = await res.text();

      await navigator.clipboard.writeText(contentForClipboard);
    } catch (error) {
      console.error(error);
      copyButtonClass = "error";
    } finally {
      copyButton.classList.add(copyButtonClass);
      copyButton.disabled = false;

      setTimeout(() => {
        copyButton.classList.remove(copyButtonClass);
      }, 3000);
    }
  });
</script>
